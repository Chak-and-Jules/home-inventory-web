# Backend API URL
# Cloud Run: set these four public values in the container environment.
NEXT_PUBLIC_API_URL=

# Firebase web app configuration (public values, never a service account key)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=home-inventory-11

# Umami Analytics Configuration
# Get your website ID from the Umami dashboard
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-website-id-here

NEXT_PUBLIC_AXIOM_DATASET=
NEXT_PUBLIC_AXIOM_TOKEN=
